#!/bin/bash


#read ip if vlan
ip=$1
if=$2
vlan=$3









if [ $ip ==  4 ];then
	pid=$(ps -ef | grep $if | grep -v 'grep' | grep -v $0 |awk '{print $2}' ) 
	
	if [ -n "${pid}" ];then
        $(kill  $pid)
	fi
        bf=$(ip link show type vlan | grep -o "$if.*@$if" | awk -F '@' '{print $1}')

	if [ -n "${bf}" ];then
	$(ip link delete $bf)
	fi

        if [ $vlan == 1 ];then
                $(dhcpd -q -cf  /home/solid/sdhcp/"$if"_1.conf -lf /var/lib/dhcp/dhcpd_$if.leases --no-pid )
        else
                if [ $if == "dasan" ];then
                        setip="10.0.21.254"
                elif [ $if == "24port" ];then
                        setip="10.0.11.254"
                elif [ $if == "48port" ];then
                        setip="10.0.31.254"
                fi

                $(ip link add link $if name $if.$vlan type vlan id $vlan)
                $(ifconfig $if.$vlan $setip netmask 255.255.255.0 up)
                $(dhcpd -q -cf  /home/solid/sdhcp/"$if"_vlan.conf -lf /var/lib/dhcp/dhcpd_$if.leases --no-pid )
        fi


elif [ $ip == 6 ];then
echo 'ipv6'


else
echo 'Wrong ip version'
fi

